test('PUT /trail/{trail_id}/favourite -should store a favourite trail for a valid user and trail ID', async (t) => {
  const user_id = 1;
  const trail_id = 2;

  const response = await t.context.got(`trail/${trail_id}/favourite`, {
    method: 'PUT',
    json: { user_id: user_id, favourite: true },
    responseType: 'json',
    throwHttpErrors: false,
  });

  t.is(response.statusCode, 200); // Ελέγχουμε ότι η απάντηση είναι επιτυχής
  t.truthy(response.body.user_id); // Ελέγχουμε ότι επιστρέφεται το user_id
  t.deepEqual(response.body.favourites, [1, 3, trail_id]); // Ελέγχουμε ότι το trail_id προστέθηκε στη λίστα
});

test('PUT /trail/{trail_id}/favourite - should return 401 if user_id is missing', async (t) => {
  const trail_id = 2; // Ορίζουμε μόνο το trail_id χωρίς user_id

  const response = await t.context.got(`trail/${trail_id}/favourite`, {
    method: 'PUT',
    json: { favourite: true }, // Δεν περιέχει user_id
    responseType: 'json',
    throwHttpErrors: false,
  });

  t.is(response.statusCode, 400); // Ελέγχουμε ότι επιστρέφεται 401 Unauthorized
  t.is(response.body.error, 'Missing required field: user_id'); // Ελέγχουμε το ακριβές μήνυμα λάθους
});

test('PUT /trail/{trail_id}/favourite - θα επιστρέφει σφάλμα αν το μονοπάτι είναι ήδη στις αγαπημένες του χρήστη', async (t) => {
  const user_id = 1;
  const trail_id = 1;

  // Πρώτα, προσθέτουμε το trail στη λίστα αγαπημένων του χρήστη (αν δεν υπάρχει ήδη)
  const usersFavourites = {
    1: [trail_id],  // Ο χρήστης με id 1 έχει ήδη το trail_id 1 στις αγαπημένες του
  };

  // Καλούμε το PUT αίτημα για να προσπαθήσουμε να προσθέσουμε ξανά το ίδιο trail στις αγαπημένες
  const response = await t.context.got(`trail/${trail_id}/favourite`, {
    method: 'PUT',
    json: { user_id: user_id, favourite: true },
    responseType: 'json',
    throwHttpErrors: false,  // Να μην πετάξει σφάλμα σε 4xx ή 5xx
  });

  // Ελέγχουμε ότι η απάντηση είναι σωστή
  t.is(response.statusCode, 400);  // Περιμένουμε 400 status όταν το μονοπάτι είναι ήδη στις αγαπημένες
  t.is(response.body.message, `Trail with ID ${trail_id} is already in the favourites list.`);  // Το μήνυμα πρέπει να είναι σωστό
});
