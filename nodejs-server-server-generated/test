test('POST /trail - createTrail should create a new trail', async (t) => {
	const trailData = {
	  name: "Beach Trail",
	  traillength: 6.5,
	  description: "A scenic trail by the beach.",
	  durationHour: 1,
	  durationMin: 30,
	  traillocation: "Beachside",
	  difficultylevel: 2,
	  rate: [0],
	  trail_id: 4,
	};
  
	// Κλήση POST request για δημιουργία trail
	const response = await t.context.got.post('trail', {
		method: 'POST',
		json: {newTrail: trailData}
	});
  
	// Έλεγχος ότι ο server επιστρέφει statusCode 201 (Created)
	t.is(response.statusCode, 201);
  
	// Έλεγχος ότι τα δεδομένα που επιστρέφει είναι σωστά
	t.deepEqual(response.body, {	  
	  name: "Beach Trail",
	  traillength: 6.5,
	  description: "A scenic trail by the beach.",
	  durationHour: 1,
	  durationMin: 30,
	  trail_id: 4,  // Αυτόματο ID βασίζεται στο μέγεθος του array `trails`
	  traillocation: "Beachside",
	  difficultylevel: 2,
	  rate: [5, 4]   // Έλεγχος ότι όλα τα δεδομένα που στάλθηκαν υπάρχουν στην απάντηση
	});
  });

